# 复制为 .env（已在 .gitignore 中）并改成自己的密码。
# MySQL 是主数据源：不配置这一行时，服务会打印警告并回退到内置 JSON。
CS_LEGENDS_DB_URL=mysql+pymysql://root:your-password@127.0.0.1:3306/cs_legends?charset=utf8mb4

# 想临时用内置 JSON（离线演示 / 对比数据）时取消注释：
# CS_LEGENDS_DATA_SOURCE=json

# JWT 签名密钥（HS256，至少 32 个字符）。生产环境必须设置，否则服务拒绝启动。
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
CS_LEGENDS_JWT_SECRET=change-me-generate-with-secrets-token-urlsafe-48

# 生产环境：启用 Secure Cookie，并让缺失/过短的 JWT 密钥直接报错
# CS_LEGENDS_ENV=prod
# CS_LEGENDS_COOKIE_SECURE=true

